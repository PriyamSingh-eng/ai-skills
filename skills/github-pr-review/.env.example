# Copy this file to .env beside SKILL.md. The local .env file is ignored by Git.
# Do not commit real credentials or include them in review JSON.

# Authentication: auto uses direct REST when a token is set; otherwise it uses gh.
# Set to "token" to require direct REST, or "gh" to require GitHub CLI.
GITHUB_AUTH_MODE=auto
# GITHUB_TOKEN=put-your-token-here

# Optional GitHub Enterprise configuration for direct REST mode.
# GITHUB_ENTERPRISE_HOSTS=github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Optional Jira issue lookup.
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=put-your-jira-token-here
# JIRA_API_VERSION=3
